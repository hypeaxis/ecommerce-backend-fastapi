# Application Settings
PROJECT_NAME="E-Commerce API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db

# Security & JWT
SECRET_KEY=supersecretkey_change_me_in_production_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
